NODE_ENV=production
PORT=3001

# Public URLs
CORS_ORIGIN=https://tbuy.store
WEB_APP_URL=https://tbuy.store
APP_WEB_URL=https://tbuy.store
API_PUBLIC_URL=https://tbuy.store/api

# PocketBase
# For Docker Compose use: http://pocketbase:8090
# For local non-Docker use: http://127.0.0.1:8090
PB_BASE_URL=http://pocketbase:8090
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=replace_me

# Pinterest API credentials
PINTEREST_CLIENT_ID=replace_me
PINTEREST_CLIENT_SECRET=replace_me
PINTEREST_REDIRECT_URI=https://tbuy.store/api/pinterest/oauth/callback
PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read

# Facebook / Meta Graph OAuth (channel pack F2)
FACEBOOK_APP_ID=replace_me
FACEBOOK_APP_SECRET=replace_me
FACEBOOK_REDIRECT_URI=https://tbuy.store/api/facebook/oauth/callback
FACEBOOK_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata
# Optional: include business_management on Login Dialog (often breaks new apps)
# FACEBOOK_INCLUDE_BUSINESS_SCOPE=1
# Optional dedicated encryption key (falls back to PINTEREST_SECRETS_KEY / PB_ENCRYPTION_KEY)
# FACEBOOK_SECRETS_KEY=replace_me

# PocketBase OAuth2 providers for app sign-in/linking
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Queue tuning
PINTEREST_QUEUE_POLL_MS=15000
PINTEREST_QUEUE_BATCH=10
AI_IMAGE_QUEUE_POLL_MS=12000
AI_IMAGE_QUEUE_BATCH=5

# OpenAI Images API
OPENAI_IMAGES_MODEL=gpt-image-1
OPENAI_IMAGES_SIZE=1024x1536

# Public site domain (used for PocketBase file URL rewriting, etc.)
WEBSITE_DOMAIN=tbuy.store

# Legacy Integrated AI proxy (DEPRECATED — unused for AI Pins / Writer text).
# Text generation now uses Admin Providers (Gemini adapter) directly.
# INTEGRATED_AI_API_URL=
# INTEGRATED_AI_API_KEY=
# WEBSITE_ID=
# PROXY_ENTRANCE_ID=

# Secrets and optional infra
# Use 64 hex chars for each key (required in production).
PB_ENCRYPTION_KEY=replace_with_64_hex_chars
WORDPRESS_SECRETS_KEY=replace_with_64_hex_chars
PINTEREST_SECRETS_KEY=replace_with_64_hex_chars
# Dedicated key for Pinterest OAuth tokens (recommended). Falls back to WORDPRESS_SECRETS_KEY / PB_ENCRYPTION_KEY.
PINTEREST_SECRETS_KEY=replace_with_64_hex_chars
REDIS_URL=
