FROM node:22-bookworm-slim AS base

# API environment in Docker is injected at runtime by docker-compose.prod.yml
# `env_file: ./apps/api/.env` on the api service. Do not add `--env-file` here:
# the .env file is not copied into the image, and compose already sets process env.

# Build metadata (no secrets). Pass at build time:
#   --build-arg GIT_SHA="$(git rev-parse HEAD)"
#   --build-arg BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="seodeva-api"
LABEL org.opencontainers.image.description="Seodeva API"
LABEL org.opencontainers.image.source="https://github.com/jaimeet901-boop/pinblog-saas"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL com.seodeva.component="api"

WORKDIR /app
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
RUN npm ci --workspace apps/api

COPY apps/api ./apps/api
WORKDIR /app/apps/api

ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "src/main.js"]
