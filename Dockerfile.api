FROM node:20-bookworm-slim AS base

# API environment in Docker is injected at runtime by docker-compose.prod.yml
# `env_file: ./apps/api/.env` on the api service. Do not add `--env-file` here:
# the .env file is not copied into the image, and compose already sets process env.

WORKDIR /app
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
RUN npm ci --workspace apps/api

COPY apps/api ./apps/api
WORKDIR /app/apps/api

ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "src/main.js"]
